rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /guests/{guestId} {
      // Undangan dapat membaca satu dokumen tamu berdasarkan username.
      allow get: if true;
      allow list: if request.auth != null;

      // Link /@username boleh membuat profil tamu otomatis.
      allow create: if guestId == request.resource.data.username
        && request.resource.data.keys().hasOnly([
          'username', 'name', 'visitCount', 'createdAt', 'lastVisited'
        ])
        && request.resource.data.username is string
        && request.resource.data.name is string
        && request.resource.data.visitCount == 1;

      // Pengunjung hanya boleh menambah hitungan kunjungan dan memperbarui waktu terakhir.
      allow update: if guestId == resource.data.username
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['visitCount', 'lastVisited'])
        && request.resource.data.visitCount == resource.data.visitCount + 1;

      // Penghapusan hanya oleh admin yang login.
      allow delete: if request.auth != null;
    }
  }
}