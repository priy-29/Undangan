rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /guests/{guestId} {
      // Website undangan perlu membaca data tamu untuk mencocokkan /@username.
      allow read: if true;
      // Hanya pengguna yang sudah login Firebase yang boleh menambah/mengubah/menghapus.
      allow create, update, delete: if request.auth != null;
    }
  }
}